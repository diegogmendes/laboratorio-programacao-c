#include <stdio.h>
#include <string.h>

int main() {
    char nome[30];
    char perfil[20];
    char confirmacao[30];
    char mensagem[60] = "Bem-vindo(a), ";

    printf("Digite seu nome: ");
    scanf("%29s", nome);

    printf("Digite seu perfil (ADMIN ou COMUM): ");
    scanf("%19s", perfil);

    printf("\n===== DADOS CADASTRADOS =====\n");
    printf("Nome: %s\n", nome);
    printf("Quantidade de caracteres: %lu\n", (unsigned long)strlen(nome));

    if (strcmp(perfil, "ADMIN") == 0) {
        strcpy(confirmacao, "Administrador");
    } else if (strcmp(perfil, "COMUM") == 0) {
        strcpy(confirmacao, "Comum");
    } else {
        printf("Perfil invalido!\n");
        return 0;
    }

    printf("Perfil: %s\n", confirmacao);

    strcat(mensagem, nome);
    strcat(mensagem, "!");

    printf("\n%s\n", mensagem);
    printf("Cadastro realizado com sucesso.\n");

    return 0;
}
