#include <stdio.h>
#include <string.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

int main() {
    Funcionario f[5];
    Funcionario temp;
    int qtd, i;
    FILE *arquivo;

    printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
    scanf("%d", &qtd);
    getchar();

    if (qtd < 1 || qtd > 5) {
        printf("Quantidade invalida.\n");
        return 1;
    }

    for (i = 0; i < qtd; i++) {
        printf("\nFuncionario %d\n", i + 1);

        printf("Nome: ");
        fgets(f[i].nome, sizeof(f[i].nome), stdin);
        f[i].nome[strcspn(f[i].nome, "\n")] = '\0';

        printf("Salario: ");
        scanf("%f", &f[i].salario);

        printf("Horas extras: ");
        scanf("%d", &f[i].horasExtras);
        getchar();
    }

    arquivo = fopen("funcionarios.txt", "a");
    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo.\n");
        return 1;
    }

    for (i = 0; i < qtd; i++) {
        fprintf(arquivo, "%s;%.2f;%d\n", f[i].nome, f[i].salario, f[i].horasExtras);
    }

    fclose(arquivo);

    arquivo = fopen("funcionarios.txt", "r");
    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo para leitura.\n");
        return 1;
    }

    printf("\n=== Funcionarios cadastrados ===\n");
    while (fscanf(arquivo, " %49[^;];%f;%d", temp.nome, &temp.salario, &temp.horasExtras) == 3) {
        printf("Nome: %s | Salario: R$ %.2f | Horas extras: %d\n",
               temp.nome, temp.salario, temp.horasExtras);
    }

    fclose(arquivo);

    return 0;
}
