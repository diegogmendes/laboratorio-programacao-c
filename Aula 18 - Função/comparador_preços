#include <stdio.h>

float maiorPreco(float a, float b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

int main() {
    float preco1, preco2, maior;

    printf("===== COMPARADOR DE PRECOS =====\n");

    printf("Preco 1: ");
    scanf("%f", &preco1);

    printf("Preco 2: ");
    scanf("%f", &preco2);

    if (preco1 == preco2) {
        printf("Os precos sao iguais!\n");
    } else {
        maior = maiorPreco(preco1, preco2);
        printf("Maior preco: R$ %.2f\n", maior);
    }

    return 0;
}
