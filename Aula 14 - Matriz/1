#include <stdio.h>

int main() {
    int i, j;

    int m1[2][2] = {
        {1, 2},
        {3, 4}
    };

    printf("=== Exercicio 1: Matriz 2x2 definida no codigo ===\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            printf("| %3d ", m1[i][j]);
        }
        printf("|\n");
    }

    int m2[2][2];

    printf("\n=== Exercicio 2: Leitura de matriz 2x2 ===\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            printf("Digite o valor da posicao [%d][%d]: ", i, j);
            scanf("%d", &m2[i][j]);
        }
    }

    printf("\nMatriz digitada:\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            printf("| %3d ", m2[i][j]);
        }
        printf("|\n");
    }

    int m3[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };
    int soma = 0;

    printf("\n=== Exercicio 3: Matriz 3x3 e soma dos elementos ===\n");
    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("| %3d ", m3[i][j]);
            soma += m3[i][j];
        }
        printf("|\n");
    }

    printf("\nSoma de todos os elementos: %d\n", soma);

    return 0;
}
